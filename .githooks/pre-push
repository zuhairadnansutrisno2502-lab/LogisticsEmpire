#!/bin/sh
# Runs the CI checks before a push leaves Laptop 2. Enable once: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -m json.tool default.project.json >/dev/null || { echo "pre-push: default.project.json is invalid" >&2; exit 1; }
for t in tests/*.spec.luau; do
	lune run "$t" || { echo "pre-push: $t failed, push cancelled" >&2; exit 1; }
done
